#!/bin/sh
# Mock curl for docker compose installation tests
# Intercepts GitHub API calls and binary downloads
out=""
prev=""
for arg in "$@"; do
  case "$prev" in
    -o|--output) out="$arg" ;;
  esac
  prev="$arg"
done
case "$*" in
  *api.github.com/repos/docker/compose/releases/latest*)
    printf '{"assets":[{"name":"docker-compose-linux-x86_64","browser_download_url":"https://fake-dl.example.com/docker-compose-linux-x86_64"}]}\n'
    exit 0
    ;;
  *fake-dl.example.com*|*github.com/docker/compose/releases/download*)
    if [ -n "$out" ]; then
      cat /tmp/fake-docker-compose > "$out"
    else
      cat /tmp/fake-docker-compose
    fi
    exit 0
    ;;
esac
exec /usr/bin/curl "$@"
